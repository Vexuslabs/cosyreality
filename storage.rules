rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public marketing assets, hero banners, brochures, master plans
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Project gallery images, floor plans, blueprints
    match /projects/{projectId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // General attachments
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
